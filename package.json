{
  "name": "@pearj/am-idm-ts-types",
  "version": "0.0.0-development",
  "description": "ForgeRock IDM TypeScript Types",
  "homepage": "https://github.com/pearj/am-idm-ts-types",
  "bugs": {
    "url": "https://github.com/pearj/am-idm-ts-types/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/pearj/am-idm-ts-types.git"
  },
  "contributors": [
    {
      "name": "Joel Pearson",
      "email": "joel.pearson@gmail.com"
    }
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "24.13.2",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "prettier": "^3.9.4",
    "semantic-release": "^25.0.5",
    "type-coverage": "^2.29.7",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "scripts": {
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --testPathIgnorePatterns=type-validation.spec.ts",
    "type-check": "tsc --noEmit",
    "type-check:watch": "yarn type-check --watch",
    "build:types": "tsc --emitDeclarationOnly --declaration",
    "format": "prettier --write \"lib/**/*.ts\" \"bin/**/*.{js,ts}\" \"test/**/*.js\"",
    "lint": "eslint",
    "semantic-release": "semantic-release",
    "commit": "cz"
  },
  "dependencies": {
    "camelcase": "^5.3.0",
    "config": "^4.4.2",
    "lodash": "^4.18.1",
    "nunjucks": "^3.2.4"
  },
  "bin": {
    "gen-idm-ts-types": "bin/gen-idm-ts-types.js"
  },
  "typeCoverage": {
    "atLeast": 98
  },
  "types": "./lib/idm-globals.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "packageManager": "yarn@4.17.0"
}
